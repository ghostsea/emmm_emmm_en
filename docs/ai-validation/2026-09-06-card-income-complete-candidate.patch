+{
+  const valueFor = (effects, { ownedTiles = {}, otherCards = [], availableData = 0, roundNumber = 2 } = {}) => {
+    const decisions = [];
+    const card = { id: "dlc_34.png", price: 0, incomeGain: { credits: 9 },
+      playEffects: [{ type: "gain_resources", options: { gain: { score: 30 } } }, ...effects] };
+    const harness = createAiControllerHarness(null, {
+      currentPlayerColor: "blue", roundNumber, canStartMainAction: true,
+      blueHand: [card, ...otherCards], blueOwnedTechTiles: ownedTiles,
+      blueResources: { availableData },
+      onChooseTurnAction: (candidates) => decisions.push(...candidates),
+    });
+    harness.controller.configureAiAutoBattle({ playerIds: [harness.blue.id], suppressAutoSchedule: true });
+    const before = JSON.stringify(harness.blue);
+    harness.controller.runAiAutomationStep();
+    const candidate = decisions.find((entry) => entry.id === "playCard")?.playableCards
+      ?.find((entry) => entry.cardId === card.id);
+    assert.ok(candidate, "the actual card effect must reach the play candidate valuation");
+    assert.deepEqual(harness.blue.hand, [card, ...otherCards], "valuation must not consume the income card");
+    assert.equal(JSON.stringify(harness.blue), before, "valuation must preserve the real player");
+    return candidate.valueBreakdown.effectValue;
+  };
+  const privateEffects = cardEffects.buildPlayEffects({ cardId: "dlc_34.png" });
+  assert.deepEqual(privateEffects.map((effect) => effect.type), ["card_income", "card_count_tech_types_reward"]);
+  const anchor = valueFor([]);
+  assert.equal(valueFor(privateEffects), anchor, "the played investment cannot discard itself for income");
+  const tiles = { blue1: true, blue2: true, orange1: true, purple1: false };
+  const drawTwo = valueFor([{ type: "draw_cards", options: { count: 2 } }], { ownedTiles: tiles });
+  assert.equal(valueFor(privateEffects, { ownedTiles: tiles }), drawTwo,
+    "count the largest owned color, not all tiles, unlocked stacks or false entries");
+  const incomeCard = { id: "income-alternative", incomeGain: { energy: 1 } };
+  const withIncome = valueFor(privateEffects, { ownedTiles: tiles, otherCards: [incomeCard] });
+  assert.ok(withIncome > drawTwo, "another held card makes investment income usable");
+  const once = valueFor([privateEffects[0]], { otherCards: [incomeCard] });
+  assert.equal(valueFor([privateEffects[0], privateEffects[0]], { otherCards: [incomeCard] }), once,
+    "several income effects cannot reuse the one remaining card");
+  const blueData = cardEffects.buildPlayEffects({ cardId: "dlc_30.png" })
+    .filter((effect) => effect.type === "card_count_owned_tech_reward");
+  assert.equal(blueData.length, 1);
+  assert.equal(valueFor(blueData, { ownedTiles: tiles, availableData: 6 }),
+    valueFor([], { ownedTiles: tiles, availableData: 6 }),
+    "data at capacity has no reward value");
+  assert.equal(valueFor(blueData, { ownedTiles: tiles, availableData: 5 }),
+    valueFor([{ type: "gain_resources", options: { gain: { availableData: 1 } } }],
+      { ownedTiles: tiles, availableData: 5 }), "only the one available data space counts");
+  const tuck = cardEffects.buildPlayEffects({ cardId: "b_47.webp" })
+    .filter((effect) => effect.type === "card_tuck_played_card_to_income");
+  assert.equal(tuck.length, 1);
+  const tuckValue = valueFor(tuck);
+  assert.ok(tuckValue > anchor, "the already played card increases income without another card");
+  assert.equal(valueFor(tuck, { otherCards: [incomeCard] }), tuckValue,
+    "tucking the played card must not charge a second hand-card cost");
+  assert.ok(valueFor(tuck, { roundNumber: 4 }) > valueFor([], { roundNumber: 4 }),
+    "last-round self-tucking still has its immediate payout");
+}
+
 runAsyncControllerTests()
