diff --git a/randomizer/app/ai-controller.test.js b/randomizer/app/ai-controller.test.js
index 2e30f23d..212c3a5e 100644
--- a/randomizer/app/ai-controller.test.js
+++ b/randomizer/app/ai-controller.test.js
@@ -17346,3 +17346,27 @@ for (const roundNumber of [1, 2]) {
   }
 }
 verifyActualContinuationGains();
+
+// Opening preferences may choose a route, but terminal choices retain only
+// actual action value and the player's real final-scoring incentives.
+for (const round of [1, 3, 4]) {
+  const h = createAiControllerHarness(null, { currentPlayerColor: "blue", roundNumber: round,
+    blueResources: { score: 120, credits: 3, energy: 3 } });
+  h.blue.aiStyle = "route";
+  const before = JSON.stringify(h.blue);
+  const adjust = (id, net, marks = []) => h.controller.adjustAiActionGraphCandidateForStyle(
+    { id, available: true }, { net }, h.blue, marks).net;
+  if (round < 4) {
+    assert(adjust("orbit", 9) > adjust("scan", 10), "early route preference remains unchanged");
+  } else {
+    assert(adjust("scan", 10) > adjust("orbit", 9), "terminal value is not reversed by opening route preference");
+    for (const style of ["route", "scanner", "task", "tech", "balanced"]) {
+      h.blue.aiStyle = style;
+      assert.equal(adjust("playCard", 10), 10, "no terminal preference without a scoring incentive");
+      assert(adjust("playCard", 10, [{ formulaId: "c1" }]) > 10, "actual final formula preference remains");
+      assert.equal(adjust("launch", -5), -5, "opening style cannot soften a terminal negative action");
+    }
+    h.blue.aiStyle = "route";
+  }
+  assert.equal(JSON.stringify(h.blue), before, "style valuation is read only");
+}
