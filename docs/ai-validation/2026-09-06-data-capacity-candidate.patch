+    function getAiDataRewardAcquisitionCount(count, player = getCurrentPlayer()) {
+      const poolRoom = getAiAvailableDataRoom(player);
+      if (count <= poolRoom) return count;
+      if (!data.COMPUTER_DATA_SLOTS) return Math.min(count, poolRoom);
+      const placed = player?.dataState?.placedTokens || [];
+      const computerSlots = Object.keys(data.COMPUTER_DATA_SLOTS).map(Number);
+      const openComputerSlots = computerSlots.filter((slot) => !placed.some((token) => (
+        token.placementKind === data.PLACEMENT_KIND_COMPUTER && Number(token.placementSlot) === slot
+      ))).length;
+      const previewPlayer = structuredClone(player);
+      const openBlueSlots = Object.keys(data.BLUE_BONUS_DATA_SLOTS || {}).map(Number).filter((slot) => (
+        data.hasBlueTechInBoardSlot?.(previewPlayer, slot)
+        && !placed.some((token) => token.placementKind === data.PLACEMENT_KIND_BLUE_BONUS && Number(token.blueSlot) === slot)
+      )).length;
+      return Math.min(count, poolRoom + openComputerSlots + openBlueSlots);
+    }
